{
  "name": "magpie-workbuddy",
  "version": "0.1.6",
  "description": "WorkBuddy 国服 / 国际服双供应商 magpie 插件：浏览器、桌面与 API Key 登录，动态模型目录，流式推理与工具调用，额度、签到、限时补偿。",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "docs",
    "README.md",
    "README-TEMPLATE.md",
    "AGENTS.md",
    "CHECKLIST.md",
    "HOOKS.md",
    "UPDATING.md",
    "CHANGELOG.md",
    "MULTI-PROVIDER.md",
    "NOTICE.md",
    "LICENSE",
    "extract-contract.py",
    "registry-entry.json",
    "tests",
    "scripts",
    "examples",
    "ERROR-CODES.md",
    "GUIDE.md",
    "OFFICIAL-SOURCES.md",
    "SCORING.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "opencode-auth",
    "provider",
    "provider-plugin",
    "checkin",
    "workbuddy",
    "workbuddy-ai",
    "codebuddy",
    "tencent"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "magpie": {
    "icon": "data:image/png;base64,",
    "maxConcurrency": 4,
    "name": "WorkBuddy 双区"
  },
  "scripts": {
    "test": "node scripts/test-node.mjs",
    "test:community": "node scripts/test-community.mjs",
    "test:all": "npm test && npm run test:community",
    "check": "node scripts/check.mjs",
    "check:errors": "node scripts/check-error-codes.mjs .",
    "create": "node scripts/create.mjs",
    "release": "node scripts/release.mjs",
    "score": "node scripts/score.mjs",
    "maintenance": "node scripts/check-maintenance.mjs",
    "publish:npm": "node scripts/publish-npm.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MYCF711/magpie-workbuddy.git"
  },
